# Set default behavior to automatically normalize line endings
* text=auto eol=lf

# Specific file types
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.json text eol=lf
*.sql text eol=lf
*.md text eol=lf
*.css text eol=lf
*.html text eol=lf
*.csv text eol=lf
*.py text eol=lf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.pkl binary
