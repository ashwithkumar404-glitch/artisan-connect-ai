# Artisan Connect AI — Shared Supabase Environment Configuration Template
# Copy this file to:
#   - frontend/.env.local (for Customer Marketplace)
#   - artisan-assistant/.env.local (for Artisan Assistant)

# Supabase Project Connection URL
# Available from your Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Public / Anon API Key (safe for browser usage with RLS enabled)
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key

# Customer Marketplace Deployment URL (Opened by Artisan Assistant cross-links)
# In local development: http://localhost:5173
# In production: https://your-marketplace-app.vercel.app
VITE_MARKETPLACE_URL=http://localhost:5173

