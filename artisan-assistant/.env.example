# Supabase Connection Configuration (Required for Artisan Assistant)
# Obtain these from your Supabase Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key

# Customer Marketplace Deployment URL (Opened by the globe icon in LanguageSelector)
# In local development: http://localhost:5173 (where the frontend app runs)
# In production: https://your-marketplace-app.vercel.app
VITE_MARKETPLACE_URL=http://localhost:5173
